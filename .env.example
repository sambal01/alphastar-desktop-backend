PORT=4100
STAFF_ACCOUNT_PIN_ENABLED=false
# Persistent server-only 32-byte hex pepper (64 hex characters). Never commit a real value.
STAFF_PIN_PEPPER=
FIREBASE_API_KEY=your-desktop-web-api-key
FIREBASE_DATABASE_URL=https://alpha-star-clinic-mobile-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=alpha-star-clinic-mobile
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Use Brevo HTTPS delivery, as in Alphastar mobile. Keep the API key server-side.
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=noreply@alphastarkasiglahan.com
EMAIL_FROM_NAME=Alphastar Laboratory
BREVO_API_KEY=

# Optional legacy SMTP delivery: set EMAIL_PROVIDER=smtp to use these settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alphastar.laboratory1@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=alphastar.laboratory1@gmail.com
SMTP_FROM_NAME=Alphastar Laboratory

AUTH_CODE_EXPIRES_SECONDS=600
AUTH_PASSWORD_RESET_EXPIRES_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_REQUESTS_PER_HOUR=5
AUTH_CODE_MAX_ATTEMPTS=3
AUTH_CHALLENGE_SECRET=replace-with-a-long-random-secret

# Server-only token if enhanced Expo push security is enabled.
EXPO_ACCESS_TOKEN=

# Server-only signed Tawk webhook; never bundle these secrets in desktop or mobile.
TAWK_PROPERTY_ID=69c333b43508461c3360e229
TAWK_WEBHOOK_SECRET=
# Set true only after the separate hosted webhook receiver is configured and verified.
TAWK_WEBHOOK_RECEIVER_CONFIGURED=false
